# Copy to .env (EasyPanel: paste into the service's Environment tab) and fill in.

# First admin account, created on startup if it does not exist yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
ADMIN_NAME=Edmund

# Host port published by docker compose.
HUB_PORT=7480

# Set to false only if you reach the app over plain HTTP (no TLS in front of it).
COOKIE_SECURE=true
TRUST_PROXY=1
